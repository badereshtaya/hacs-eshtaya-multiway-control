{
  "entity": {
    "light": {
      "group_control": {
        "default": "mdi:light-switch"
      }
    },
    "switch": {
      "group_control": {
        "default": "mdi:electric-switch"
      },
      "group_enabled": {
        "default": "mdi:link-variant"
      }
    },
    "sensor": {
      "health": {
        "default": "mdi:heart-pulse"
      },
      "last_source": {
        "default": "mdi:gesture-tap-button"
      },
      "last_latency": {
        "default": "mdi:timer-outline"
      }
    },
    "binary_sensor": {
      "in_sync": {
        "default": "mdi:link-variant"
      }
    },
    "button": {
      "sync_now": {
        "default": "mdi:sync"
      }
    }
  },
  "services": {
    "sync_group": {
      "service": "mdi:sync"
    },
    "sync_all": {
      "service": "mdi:sync-circle"
    },
    "enable_group": {
      "service": "mdi:link-variant"
    },
    "disable_group": {
      "service": "mdi:link-variant-off"
    },
    "set_group_state": {
      "service": "mdi:electric-switch"
    },
    "test_group": {
      "service": "mdi:test-tube"
    }
  }
}
